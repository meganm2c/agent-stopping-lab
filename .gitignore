# Credentials and machine-specific configuration
.env
.env.*
!.env.example

# Python environments, caches, and build outputs
.venv/
.phoenix-venv/
__pycache__/
.pytest_cache/
*.py[cod]
*.egg-info/
build/
dist/

# OS/editor leftovers
.DS_Store
*.swp
*.swo
*~

# Local Phoenix server state and databases
.phoenix/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm

# Logs and temporary output
*.log
*.tmp
*.temp

# Preserve reviewed research snapshots; new output stays local by default.
/results/*
!/results/README.md
!/results/SHA256SUMS
!/results/live-pilot.jsonl
!/results/live-pilot.summary.json
!/results/pilot-rescored-v2.jsonl
!/results/hard-comparison.jsonl
!/results/easy-live.json
!/results/experiment-manifest.json
!/results/phase3-controls-before.json
!/results/phase3-frozen-policy.json
!/results/phase3-tool-json-schemas.json

!/results/phoenix-20260928T011340Z/
/results/phoenix-20260928T011340Z/*
!/results/phoenix-20260928T011340Z/*.json
!/results/phoenix-20260928T011340Z/*.jsonl
!/results/phoenix-20260928T011340Z/traces/
/results/phoenix-20260928T011340Z/traces/*
!/results/phoenix-20260928T011340Z/traces/*.json

!/results/phoenix-repeatability/
/results/phoenix-repeatability/*
!/results/phoenix-repeatability/*.json

!/results/phase3-variation/
/results/phase3-variation/*
!/results/phase3-variation/*.json
!/results/phase3-variation/*.jsonl
!/results/phase3-variation/traces/
/results/phase3-variation/traces/*
!/results/phase3-variation/traces/*.json

!/results/phase3-comparison/
/results/phase3-comparison/*
!/results/phase3-comparison/*.json
!/results/phase3-comparison/*.jsonl
/results/phase3-comparison/*-duplicate-span-annotations.json
!/results/phase3-comparison/traces/
/results/phase3-comparison/traces/*
!/results/phase3-comparison/traces/*.json

!/results/screenshots/
/results/screenshots/*
!/results/screenshots/adaptive-*.png
!/results/screenshots/dataset-examples.png
!/results/screenshots/experiment-list.png
!/results/screenshots/experiment-metrics.png
!/results/screenshots/hard-trace.png

# Isolated replay demo environment
.demo-venv/
